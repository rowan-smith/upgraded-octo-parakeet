{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Local": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "--url http://localhost:5262 --name local-dev",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "Register": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "--url http://localhost:5262 --token REPLACE_WITH_REGISTRATION_TOKEN --name local-dev",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  }
}
