{

  "Logging": {

    "LogLevel": {

      "Default": "Information",

      "Microsoft.AspNetCore": "Warning"

    }

  },

  "AllowedHosts": "*",

  "ConnectionStrings": {

    "Platform": "Data Source=data/forgedeck.db"

  },

  "Data": {

    "ProtectionKeysPath": "data/keys"

  },

  "Source": {

    "DefaultRepository": {

      "Provider": "github",

      "Owner": "rowan-smith",

      "Name": "upgraded-octo-parakeet",

      "Url": "https://github.com/rowan-smith/upgraded-octo-parakeet",

      "DefaultBranch": "main"

    }

  },

  "Review": {

    "AllowSelfReview": true,

    "MinimumApprovals": 1,

    "RequiredChecks": [ "Build", "Unit Tests", "Integration Tests", "E2E Tests" ]

  },

  "Pipelines": {

    "ExecutionMode": "Simulated",

    "RunnerHeartbeatTimeoutSeconds": 30,

    "RunnerDisconnectGraceSeconds": 60,

    "ArtifactRoot": "data/pipeline-artifacts",

    "LogRoot": "data/pipeline-logs",

    "WorkspaceRoot": "data/runner-work"

  },

  "Licensing": {

    "LicencePath": "data/licence.json"

  },

  "Modules": {

    "git": { "Enabled": false },

    "review": { "Enabled": true },

    "review-commercial": { "Enabled": true },

    "pipelines": { "Enabled": true },

    "checks-demo": { "Enabled": false }

  }

}

