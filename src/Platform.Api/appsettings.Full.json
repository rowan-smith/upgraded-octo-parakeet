{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Modules": {
    "git": { "Enabled": true },
    "review": { "Enabled": true },
    "review-commercial": { "Enabled": true },
    "pipelines": { "Enabled": true },
    "checks-demo": { "Enabled": false }
  },
  "Pipelines": {
    "ExecutionMode": "Runner"
  },
  "Review": {
    "AllowSelfReview": true,
    "MinimumApprovals": 1,
    "RequiredChecks": [ "Build", "Unit Tests", "Integration Tests", "E2E Tests" ]
  }
}
