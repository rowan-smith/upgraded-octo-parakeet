<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Modules.Review.Commercial</RootNamespace>
    <ForgeDeckCommercial>true</ForgeDeckCommercial>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Description>ForgeDeck Review Enterprise Edition extensions (proprietary, source-available).</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" />
    <None Include="..\LICENSE" Link="EE-LICENSE.txt" Pack="true" PackagePath="EE-LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules.Review\Modules.Review.csproj" />
    <ProjectReference Include="..\..\src\Platform.Contracts\Platform.Contracts.csproj" />
  </ItemGroup>

</Project>
